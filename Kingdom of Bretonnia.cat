    <entryLink id="0a00e3a7-a4a8-524a-8ea8-5e13669ebf74" name="Paladin" hidden="false" collective="false" import="true" targetId="940f6e46-3b38-55cd-9390-6a7681b58018" type="selectionEntry">
      <categoryLinks>
        <categoryLink id="e869c262-8e19-5f98-9939-c808022a6109" name="Characters" hidden="false" targetId="9af06238-d538-5ab3-bd34-0a00aa3ff07c" primary="true"/>
      </categoryLinks>
    </entryLink>
    <entryLink id="050fc6c4-c637-53be-a8f0-554d281aec05" name="Damsel" hidden="false" collective="false" import="true" targetId="899150be-2105-5533-846d-6544d6bfdeab" type="selectionEntry">
      <categoryLinks>
        <categoryLink id="d2a60a35-5ee2-5103-9a18-36e710d1ebc6" name="Characters" hidden="false" targetId="9af06238-d538-5ab3-bd34-0a00aa3ff07c" primary="true"/>
      </categoryLinks>
    </entryLink>
    <entryLink id="0e488006-7e0a-518d-91ab-22c11f0315cb" name="Sergeant-at-Arms" hidden="false" collective="false" import="true" targetId="a267bfa5-59f1-5277-9022-ec5337c12803" type="selectionEntry">
      <categoryLinks>
        <categoryLink id="19d2f29e-44ac-533c-ba25-bb74ec5a6f0e" name="Characters" hidden="false" targetId="9af06238-d538-5ab3-bd34-0a00aa3ff07c" primary="true"/>
      </categoryLinks>
    </entryLink>
