    <catalogueLink id="da9f6aa2-c2bb-5a96-b417-016c86d25693" name="Orc &amp; Goblin Tribes" targetId="46850b9a-895e-5fed-9182-bf0278522f92" type="catalogue" importRootEntries="false"/>
    <catalogueLink id="d38f8b5f-d253-5027-b7d5-51b30c8e0a0f" name="Ogre Kingdoms" targetId="5c829d14-9753-50d7-80fc-2aede5989031" type="catalogue" importRootEntries="false"/>
