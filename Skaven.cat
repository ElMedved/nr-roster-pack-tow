    <selectionEntryGroup id="b8b21a55-6b2c-586f-91eb-83c81fde4bbb" name="Skaven - Weapon" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="0707f1a7-0af6-5014-8e01-bec4b31dd07c" name="The Fellblade {renegade}" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="100"/>
          </costs>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="2b6710be-3ef5-5686-9ce0-53c754e3f0f1" type="max"/>
          </constraints>
        </selectionEntry>
        <selectionEntry id="fc41327f-09cd-552e-bebd-1494a72172be" name="Weeping Blade {renegade}" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="50"/>
          </costs>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="64a6e36e-8581-54af-98f2-9ddc69da1a9b" type="max"/>
          </constraints>
        </selectionEntry>
        <selectionEntry id="5d5b749c-8d1b-52d2-88e7-53fd66e7954c" name="Weeping Blade" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="40"/>
          </costs>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="151d4b84-129a-5280-9316-d01a93bee7c8" type="max"/>
          </constraints>
          <profiles>
            <profile id="a871d489-6d46-5bf8-aee2-0151dffa4e82" name="Weeping Blade" hidden="false" typeId="bb5fb89a-5eb5-5138-af87-f1c6e953cc42" typeName="Magic Item">
              <characteristics>
                <characteristic name="Category" typeId="4a76d5ad-8dbe-501c-8a46-2804367e2b8d">weapon</characteristic>
                <characteristic name="Effect" typeId="740945df-ffc0-53b8-9066-93400c97c5d0">This weapon weeps a venom so corrosive it can melt through armour with ease to deeply pierce and poison the flesh beneath.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="7cbb3408-f5a9-5ca2-bdfe-5f0aa8a1b9ca" name="Blade of Nurglitch" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="35"/>
          </costs>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="22b12577-918f-50b9-bd72-57f84f65520b" type="max"/>
          </constraints>
          <profiles>
            <profile id="a4948a14-f890-5e48-8d63-868a54ffc04e" name="Blade of Nurglitch" hidden="false" typeId="bb5fb89a-5eb5-5138-af87-f1c6e953cc42" typeName="Magic Item">
              <characteristics>
                <characteristic name="Category" typeId="4a76d5ad-8dbe-501c-8a46-2804367e2b8d">weapon</characteristic>
                <characteristic name="Effect" typeId="740945df-ffc0-53b8-9066-93400c97c5d0">Blessed by the Plaguelord of Clan Pestilens, even a scratch from this filth-encrusted weapon can turn into instant infection.

Notes: Any enemy model that suffers one or more unsaved wounds from the Blade of Nurglitch must immediately make a Toughness test. If this test is failed, they suffer a -1 modifier to their Toughness characteristic (to a minimum of 1) for the remainder of the game.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="60aa965d-eb22-5867-ac21-e5d79cbc86fa" name="Blade of Nurglitch {renegade}" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="15"/>
          </costs>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="846d3929-df35-5f7f-bfb7-131700eadf5f" type="max"/>
          </constraints>
        </selectionEntry>
        <selectionEntry id="09a00291-fb2d-5250-bc6a-c1e25ed0c6cf" name="Death Globe* {renegade}" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
