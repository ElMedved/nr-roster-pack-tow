<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="1e54d5a3-867b-5603-a37a-dc891b0edd37" name="Vampire Counts" revision="1" battleScribeVersion="2.03" authorName="The Old World Dataset Generator" library="false" gameSystemId="6aa172e3-070a-508c-b144-5cd51fba587c" gameSystemRevision="1" type="catalogue">
