<?xml version="1.0" encoding="utf-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="3c032cfc-ad6b-5ee3-96cf-724f95f542de" name="Beastmen Brayherds" revision="2" battleScribeVersion="2.03" authorName="The Old World Dataset Generator" library="false" gameSystemId="6aa172e3-070a-508c-b144-5cd51fba587c" gameSystemRevision="2" type="catalogue">
