    <catalogueLink id="26c1c13a-3d04-5d98-8b10-684b79d11c08" name="Kingdom of Bretonnia" targetId="291cb01a-49c8-5b08-bbff-22e73e68e88c" type="catalogue" importRootEntries="false"/>
    <catalogueLink id="95330e56-3076-53d4-b6ff-ab8d14573e61" name="Wood Elf Realms" targetId="9a5e8dea-b938-5dca-8ab5-af84b7d6e0bf" type="catalogue" importRootEntries="false"/>
    <catalogueLink id="6dd85fb7-dcc3-54f2-9af4-72a9c55ae6bd" name="High Elf Realms" targetId="41e0a09b-7c51-5795-a282-9e7f952f6820" type="catalogue" importRootEntries="false"/>
