            <cost name="pts" typeId="points" value="35"/>
          </costs>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="5f4a19e9-0e47-5698-8707-33bf5ea54574" type="max"/>
          </constraints>
          <profiles>
            <profile id="5a61d557-036f-5d5f-8588-518627153a5f" name="Daemonic Robes" hidden="false" typeId="bb5fb89a-5eb5-5138-af87-f1c6e953cc42" typeName="Magic Item">
              <characteristics>
                <characteristic name="Category" typeId="4a76d5ad-8dbe-501c-8a46-2804367e2b8d">daemonic-gift-common</characteristic>
                <characteristic name="Effect" typeId="740945df-ffc0-53b8-9066-93400c97c5d0">The Daemon is clad in shimmering robes that deflect the fury of incoming blows.

This model cannot be wounded by a roll To Wound of 2, regardless of the Strength of the attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
