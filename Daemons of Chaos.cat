            <cost name="pts" typeId="points" value="55"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b6c41a2e-d701-5e32-ba7c-07b95c77e7bc" name="Winged Horror" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="50"/>
          </costs>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="e4029b28-8171-540b-8739-74afa33fa0da" type="max"/>
          </constraints>
          <profiles>
            <profile id="570407d5-4caf-5ee7-9539-99a0c17ff025" name="Winged Horror" hidden="false" typeId="bb5fb89a-5eb5-5138-af87-f1c6e953cc42" typeName="Magic Item">
              <characteristics>
                <characteristic name="Category" typeId="4a76d5ad-8dbe-501c-8a46-2804367e2b8d">daemonic-gift-common</characteristic>
                <characteristic name="Effect" typeId="740945df-ffc0-53b8-9066-93400c97c5d0">Gigantic wings sprout from the Daemon's back, allowing it to dive upon the unprepared foe.

Daemonic Heralds whose troop type is regular infantry only. This model gains the Fly (8) and Swiftstride special rules.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="b6c41a2e-d701-5e32-ba7c-07b95c77e7bc" name="Winged Horror" hidden="false" collective="false" import="true" type="upgrade">
