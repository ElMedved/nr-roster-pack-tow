        </selectionEntry>
        <selectionEntry id="e4651332-6659-5e86-87a4-d679f9b901a3" name="Iridescent Corona* {renegade}" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="30"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f88ab03e-c401-5a16-88a8-ce75d1975e31" name="Twin Heads" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="20"/>
          </costs>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="74c243ec-e15d-5fe9-afc8-8c0b34458188" type="max"/>
          </constraints>
          <profiles>
            <profile id="2985d1ac-c038-5114-a0b8-c0a86a323dd9" name="Twin Heads" hidden="false" typeId="bb5fb89a-5eb5-5138-af87-f1c6e953cc42" typeName="Magic Item">
              <characteristics>
                <characteristic name="Category" typeId="4a76d5ad-8dbe-501c-8a46-2804367e2b8d">daemonic-gift-tzeentch</characteristic>
                <characteristic name="Effect" typeId="740945df-ffc0-53b8-9066-93400c97c5d0">Possessed of two personalities and two intellects, this two-headed Daemon is a master of the Winds of Magic.

This model knows one more spell (chosen in the usual way) than is normal for their Level of Wizardry.
Note that this does not increase the Wizard's Level.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="a082890d-b606-503f-ab60-9c525bf878c1" name="Twin Heads {renegade}" hidden="false" collective="false" import="true" type="upgrade">
