    <selectionEntryGroup id="1e5c24f9-6a1e-5007-81a2-a12955a07142" name="Daemonic Icons Tzeentch - Daemonic Icon Tzeentch" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="f07b1313-1a90-5f2f-9ed7-c8d6fc21026e" name="Banner of Discord" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="60"/>
          </costs>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="b8d647d6-92ad-5c1e-83e8-e301b208eb20" type="max"/>
          </constraints>
          <profiles>
            <profile id="e45788e9-9cbe-571a-bf91-aa0bbcbc7ec5" name="Banner of Discord" hidden="false" typeId="bb5fb89a-5eb5-5138-af87-f1c6e953cc42" typeName="Magic Item">
              <characteristics>
                <characteristic name="Category" typeId="4a76d5ad-8dbe-501c-8a46-2804367e2b8d">daemonic-icon-tzeentch</characteristic>
                <characteristic name="Effect" typeId="740945df-ffc0-53b8-9066-93400c97c5d0">The air around this warped banner shimmers with the explosive unbinding of enemy spells.

A unit carrying the Banner of Discord gains the Magic Resistance (-3) special rule. In addition, friendly units within 6" of the model carrying this standard gain the Magic Resistance (-1) special rule.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="f07b1313-1a90-5f2f-9ed7-c8d6fc21026e" name="Banner of Discord" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
