      <selectionEntries>
        <selectionEntry id="fccfe759-4d80-5b8d-bf9a-676bc46bf834" name="Æther Blade" hidden="false" collective="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="55"/>
          </costs>
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="3171e653-55d1-52ae-af47-be7dc36819dc" type="max"/>
          </constraints>
          <profiles>
            <profile id="6703ec7a-4779-5e1c-81f8-0d48d6a90207" name="Æther Blade" hidden="false" typeId="bb5fb89a-5eb5-5138-af87-f1c6e953cc42" typeName="Magic Item">
              <characteristics>
                <characteristic name="Category" typeId="4a76d5ad-8dbe-501c-8a46-2804367e2b8d">daemonic-gift-common</characteristic>
                <characteristic name="Effect" typeId="740945df-ffc0-53b8-9066-93400c97c5d0">The Daemon's weapon flickers in and out of reality, slipping through armour and into the soft flesh beneath.

No armour saves are permitted against wounds caused by this Daemon's hand weapon (Ward and Regeneration saves can be attempted as normal).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="fccfe759-4d80-5b8d-bf9a-676bc46bf834" name="Æther Blade" hidden="false" collective="false" import="true" type="upgrade">
